---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }} — Writing</title>
  <id>{{ site.url }}/writing/</id>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/writing/"/>
  <updated>{% if collections.posts.length %}{{ collections.posts[0].date | isoDate }}{% else %}2026-11-06{% endif %}T00:00:00Z</updated>
  <author><name>{{ site.name }}</name></author>
  {% for post in collections.posts %}
  <entry>
    <title>{{ post.data.title | escape }}</title>
    <id>{{ site.url }}{{ post.url }}</id>
    <link href="{{ site.url }}{{ post.url }}"/>
    <updated>{{ post.date | isoDate }}T00:00:00Z</updated>
    <summary>{{ post.data.description | default('') | escape }}</summary>
  </entry>
  {% endfor %}
</feed>
