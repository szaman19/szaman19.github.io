{% if posts.length %}
<ol class="post-list">
  {% for post in posts %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a><time class="meta" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}</li>
  {% endfor %}
</ol>
{% else %}
<p class="meta">No posts yet. Essays in this series will appear here.</p>
{% endif %}
